DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
# 기본값은 Google 전송 금지. 유료 프로젝트 및 사용자 고지 준비 후에만 true로 변경.
GEMINI_ALLOW_USER_INPUT="false"
SESSION_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NICKNAME=""
# 카카오 로그인. 카카오 개발자 콘솔 > 앱 > 플랫폼 키 > REST API 키. 비우면 카카오 버튼이 숨는다.
# 같은 화면의 "카카오 로그인 리다이렉트 URI" 에 <사이트 주소>/api/auth/kakao/callback 을 등록한다.
KAKAO_REST_API_KEY=""
# 같은 화면 > 클라이언트 시크릿. 새 REST API 키는 기본으로 켜져 있어서 채워야 한다(끄면 비워 둔다).
KAKAO_CLIENT_SECRET=""